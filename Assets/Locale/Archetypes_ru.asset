  - m_Id: 26700021760
    m_Localized: "\u0410\u0440\u0445\u0438\u043C\u0430\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 604746416128
    m_Localized: "\u041F\u0438\u0440\u043E\u043C\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 241221894144
    m_Localized: "\u0412\u043B\u0430\u0434\u0435\u0435\u0442 \u0432\u0441\u0435\u043C\u0438
      \u0432\u0438\u0434\u0430\u043C\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 454640664576
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 3 \u0431\u0440\u043E\u043D\u0438
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 10 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0439
      \u043C\u0430\u043D\u044B.\r\n\r\n\u041F\u0440\u0438 \u043A\u0430\u0436\u0434\u043E\u043C
      \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0438 \u0443\u0440\u043E\u043D\u0430
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 1 \u0437\u0430\u0440\u044F\u0434
      \u0420\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u0438\u044F, \u0434\u043E
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0430 5.\r\n\u041A\u0430\u0436\u0434\u044B\u0439
      \u0437\u0430\u0440\u044F\u0434 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439 \u0446\u0435\u043B\u044C\u044E
      \u0443\u0440\u043E\u043D \u043D\u0430 8%."
    m_Metadata:
      m_Items: []
  - m_Id: 589076496384
    m_Localized: "\u0420\u0430\u0437 \u0432 5 \u0441\u0435\u043A\u0443\u043D\u0434
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 1 \u0437\u0430\u0440\u044F\u0434
      \u041F\u043E\u043F\u0443\u0442\u043D\u043E\u0433\u043E \u0432\u0435\u0442\u0440\u0430,
      \u0434\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0430 3.\n\u041A\u0430\u0436\u0434\u044B\u0439
      \u0437\u0430\u0440\u044F\u0434 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043D\u0430 5% \u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0439
      \u0443\u0440\u043E\u043D \u043D\u0430 10%.\n\n\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u043D\u0430\u043D\u043E\u0441\u0438\u043C\u044B\u0439
      \u0443\u0440\u043E\u043D \u043F\u043E \u043C\u0435\u0440\u0435 \u0438\u0445
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F, \u0434\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0430
      \u0432 40%."
    m_Metadata:
      m_Items: []
  - m_Id: 678616498176
    m_Localized: "25% \u043D\u0430\u043D\u043E\u0441\u0438\u043C\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0432\u0438\u0434\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F.\n\n\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442 \u044D\u0444\u0444\u0435\u043A\u0442
      \u0413\u043E\u0440\u0435\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      30% \u043E\u0442 \u0443\u0440\u043E\u043D\u0430 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F
      \u0432 \u0432\u0438\u0434\u0435 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 746736189440
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435
      \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0438\u0436\u0435 70%, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u044D\u0444\u0444\u0435\u043A\u0442 \u0412\u0438\u0441\u043A\u0438 \u0428\u0435\u0440\u0438\u0444\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043D\u0430 13% \u0438 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      65% \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430
      \u0432 \u0432\u0438\u0434\u0435 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 7 \u0441\u0435\u043A\u0443\u043D\u0434.\n\n\u0417\u0430
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u043D\u0430 \u043F\u043E\u043B\u0435
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 5% \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u044F
      \u0443\u0440\u043E\u043D\u0430, \u0432\u043F\u043B\u043E\u0442\u044C \u0434\u043E
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0430 \u0432 20%."
    m_Metadata:
      m_Items: []
