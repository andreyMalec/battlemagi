  - m_Id: 22646143066112
    m_Localized: "\u0412\u043E\u0437\u0434\u0443\u0448\u043D\u0430\u044F \u043F\u0443\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 22767836602368
    m_Localized: "\u041F\u043E\u0442\u043E\u043A \u0441\u0436\u0430\u0442\u043E\u0433\u043E
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u043C\u0435\u0440\u0442\u043E\u043D\u043E\u0441\u043D\u044B\u0439
      \u0441\u043D\u0430\u0440\u044F\u0434 \u0447\u0438\u0441\u0442\u043E\u0433\u043E
      \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22834450538496
    m_Localized: "\u041C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u0442
      \u0432 \u0446\u0435\u043B\u044C, \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u044F
      \u043E\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439
      \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F
      [[echo|\u0437\u0430\u0440\u044F\u0434 \u044D\u0445\u043E]] \u043F\u0440\u0438
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u043F\u043E \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443.\n\n\u0412\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430: [affects]\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
      [moveSpeed]\n\u0423\u0440\u043E\u043D: [damage.amount]\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u0432: [maxBounces]\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      [[echo|\u044D\u0445\u043E]]: [echoCount]"
    m_Metadata:
      m_Items: []
  - m_Id: 22909906067456
    m_Localized: "\u0428\u0430\u0440\u043E\u0432\u0430\u044F \u043C\u043E\u043B\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 22932710498304
    m_Localized: "\u0416\u0438\u0432\u0430\u044F \u0438\u0441\u043A\u0440\u0430 \u0431\u0443\u0440\u0438,
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043C\u0435\u0447\u0443\u0449\u0430\u044F\u0441\u044F
      \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445 \u0434\u043E\u0431\u044B\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 23079586635776
    m_Localized: "\u0421\u043D\u0430\u0440\u044F\u0434 \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 [forkCount] \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043A\u043E\u043F\u0438\u0438 \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438,
      \u043E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442 \u043E\u0442
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439 \u0438
      \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C \u0432
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0440\u0430\u0434\u0438\u0443\u0441\u0435.\n\n\u0412\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430: [affects]\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
      [moveSpeed]\n\u0423\u0440\u043E\u043D: [damage.amount]\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043E\u0442\u0441\u043A\u043E\u043A\u043E\u0432: [maxBounces]"
    m_Metadata:
      m_Items: []
  - m_Id: 23116743974912
    m_Localized: "\u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 23269026570240
    m_Localized: "\u041D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u044E
      \u0438\u0437\u0443\u043C\u0440\u0443\u0434\u0430 \u0432 \u0437\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u0443\u044E
      \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0443\u044E \u0441\u0442\u0440\u0435\u043B\u0443,
      \u0442\u0443\u0433\u043E \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u0443\u044E
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 23270830120960
    m_Localized: "\u0423\u0440\u043E\u043D \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0432\u044B\u043F\u0443\u0449\u0435\u043D\u043E
      \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442.\n\n\u0412\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430: [affects]\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
      [moveSpeed]\n\u0423\u0440\u043E\u043D \u043F\u0440\u0438 \u043F\u043E\u043B\u043D\u043E\u043C
      \u0437\u0430\u0440\u044F\u0434\u0435: [damage.amount]\n[[charging|\u0412\u0440\u0435\u043C\u044F
      \u0437\u0430\u0440\u044F\u0434\u043A\u0438]]: [chargeDuration]\n\u041F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442
      \u0446\u0435\u043B\u0435\u0439: [maxPierces]"
    m_Metadata:
      m_Items: []
  - m_Id: 23475373744128
    m_Localized: "\u0421\u0442\u0435\u043D\u0430 \u0437\u0435\u043C\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 23478402031616
    m_Localized: "\u0412\u043E\u043B\u043D\u0430 \u0433\u0435\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0441\u0438\u043B\u044B \u0432\u044B\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438\u0437-\u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0438, \u0432\u043E\u0437\u0434\u0432\u0438\u0433\u0430\u044F
      \u043F\u0440\u043E\u0447\u043D\u044B\u0439 \u0431\u0430\u0440\u044C\u0435\u0440
      \u0438\u0437 \u043F\u043E\u0447\u0432\u044B \u0438 \u043A\u0430\u043C\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 23667326066688
    m_Localized: "\u0411\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044E\u0449\u0438\u0435\u0441\u044F
      \u0430\u0442\u0430\u043A\u0438 \u0438 \u0438\u0437\u043C\u0435\u043D\u044F\u0435\u0442
      \u0444\u043E\u0440\u043C\u0443 \u043F\u043E\u043B\u044F \u0431\u043E\u044F.\n[F]
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u0440\u0435\u0436\u0438\u043C\u0430.\n\n\u0412\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430: [affects]\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      [[echo|\u044D\u0445\u043E]]: [echoCount]\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435
      \u0441\u0442\u0435\u043D\u044B: 100\n\u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
      \u0441\u0442\u0435\u043D: [spawn.instanceLimit]"
    m_Metadata:
      m_Items: []
  - m_Id: 23685189607424
    m_Localized: "\u0422\u043B\u0435\u044E\u0449\u0438\u0439 \u0445\u043B\u044B\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 23698972090368
    m_Localized: "\u0418\u0437\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F
      \u0436\u0433\u0443\u0447\u0438\u0439 \u043F\u043E\u0442\u043E\u043A \u043B\u0430\u0432\u044B,
      \u043E\u043F\u0443\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445
      \u0432\u0440\u0430\u0433\u043E\u0432 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u043C\u0438
      \u0446\u0435\u043F\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 23949078437888
    m_Localized: "\u0417\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0432\u043E\u043A\u0440\u0443\u0433 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u0442\u0435\u043B\u044F
      \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0438\u043C \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D \u043E\u0442 \u0433\u043E\u0440\u0435\u043D\u0438\u044F.\n\n\u0412\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430: [affects]\n\u0420\u0430\u0434\u0438\u0443\u0441 \u0437\u0430\u0445\u0432\u0430\u0442\u0430:
      [radius]\n\u0423\u0440\u043E\u043D: [effect1.damagePerSecond]\n\u0418\u043D\u0442\u0435\u0440\u0432\u0430\u043B
      \u0443\u0440\u043E\u043D\u0430: [effect1.tick]\n\u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C:
      [effect1.duration]"
    m_Metadata:
      m_Items: []
  - m_Id: 24115806216192
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0428\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 24117731401728
    m_Localized: "\u0421\u0433\u0443\u0441\u0442\u043E\u043A \u043F\u043B\u0430\u043C\u0435\u043D\u0438,
      \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u044E\u0449\u0438\u0439 \u043F\u0440\u0438
      \u0443\u0434\u0430\u0440\u0435 \u0438 \u0438\u0441\u043F\u0435\u043F\u0435\u043B\u044F\u044E\u0449\u0438\u0439
      \u0432\u0441\u0435\u0445, \u043A\u0442\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 24260392263680
    m_Localized: "\u0412\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438
      \u0443\u0434\u0430\u0440\u0435, \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D
      \u043F\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0446\u0435\u043B\u0438 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044F
      [[forced movement|\u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435]].\n\n\u0412\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430: [affects]\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
      [moveSpeed]\n\u0423\u0440\u043E\u043D \u0432\u0437\u0440\u044B\u0432\u0430:
      [onHitSpawn.damage.amount]. \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435\u043C
      \u043E\u0442 \u0432\u0437\u0440\u044B\u0432\u0430.\n\u0420\u0430\u0434\u0438\u0443\u0441
      \u0432\u0437\u0440\u044B\u0432\u0430: [onHitSpawn.range]"
    m_Metadata:
      m_Items: []
  - m_Id: 24261986099200
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0440\u044B\u0432\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 24356471185408
    m_Localized: "\u041C\u0447\u0438\u0442\u0435\u0441\u044C \u0432\u043F\u0435\u0440\u0435\u0434
      \u0441 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0437\u0430 \u0441\u043E\u0431\u043E\u0439
      \u0448\u043B\u0435\u0439\u0444 \u0436\u0433\u0443\u0447\u0435\u0433\u043E \u043F\u043B\u0430\u043C\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 24358052438016
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0441\u043B\u0435\u0434.\n\n\u0412\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u043D\u0430: [affects]\n[[channelling|\u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F]]: [channelDuration]\n\u0423\u0440\u043E\u043D:
      [atStepDistanceSpawn.damage.perSecond]\n\u0418\u043D\u0442\u0435\u0440\u0432\u0430\u043B
