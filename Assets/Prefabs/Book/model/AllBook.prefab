  m_text: "\u0417\u0430\u0440\u044F\u0436\u0430\u0435\u043C\u043E\u0435 - \u044D\u0442\u043E
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F,
    \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u0443\u0440\u043E\u043D \u0440\u0430\u0441\u0442\u0435\u0442 \u043F\u043E \u043C\u0435\u0440\u0435
    \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u043C\u0430\u043D\u043E\u0439.\n\u0417\u0430\u0440\u044F\u0434\u043A\u0430
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043E
    \u0442\u0435\u0445 \u043F\u043E\u0440, \u043F\u043E\u043A\u0430 \u0438\u0433\u0440\u043E\u043A
    \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 [\u041B\u041A\u041C]
    \u0438\u043B\u0438 \u043D\u0435 \u0438\u0441\u0447\u0435\u0440\u043F\u0430\u0435\u0442
    \u043C\u0430\u043D\u0443."
